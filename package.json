{
  "name": "side-quest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:phone": "vite --host 0.0.0.0",
    "build": "tsx scripts/pack-manifest.ts && tsx scripts/validate-content.ts && tsc -b && vite build && tsx scripts/check-budget.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --exclude \"tests/**/*.balance.test.ts\"",
    "test:balance": "vitest run balance",
    "typecheck": "tsc -b --pretty false",
    "test:e2e": "playwright test",
    "test:release": "playwright test --grep @release",
    "format": "prettier --write src scripts tests *.ts *.json index.html",
    "imprint": "tsx scripts/imprint.ts",
    "fonts": "tsx scripts/fonts.ts",
    "cards:review": "tsx scripts/cards-review.ts",
    "fixtures:saves": "tsx scripts/save-fixtures.ts",
    "content:manifest": "tsx scripts/pack-manifest.ts",
    "cabiin:reference": "tsx scripts/cabiin-reference.ts",
    "house:reference": "tsx scripts/house-reference.ts",
    "generate:icons": "tsx scripts/icons.ts",
    "test:workshop": "playwright test --config playwright.workshop.config.ts",
    "test:update": "tsx scripts/check-update.ts",
    "art:league": "tsx scripts/league-art.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@3d-dice/dice-box-threejs": "0.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
